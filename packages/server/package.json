{
    "name": "@aurora-launcher/server",
    "version": "0.0.5-dev.99",
    "description": "LauncherServer for AuroraLauncher",
    "keywords": [
        "launcher",
        "minecraft"
    ],
    "homepage": "https://aurora-launcher.ru",
    "bugs": {
        "url": "https://github.com/AuroraTeam/AuroraLauncher/issues"
    },
    "license": "MIT",
    "author": "AuroraTeam",
    "contributors": [
        "JoCat (https://github.com/JoCat)",
        "LoomeL (https://github.com/LoomeL)",
        "FIXxp (https://github.com/FIXxp)",
        "IsTopNick (https://github.com/IsTopNick)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AuroraTeam/AuroraLauncher.git"
    },
    "main": "dist/LauncherServer.js",
    "scripts": {
        "dev": "tsup --watch --onSuccess \"node .\"",
        "build": "tsup",
        "build:bin": "pkg dist/LauncherServer.js -t node26-linux-x64,node26-macos-x64,node26-win-x64 --out-path dist --compress GZip",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/*.test.cjs",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "start": "node ."
    },
    "dependencies": {
        "@aurora-launcher/core": "workspace:^",
        "@fastify/multipart": "^10.1.4",
        "@fastify/static": "^10.1.6",
        "@freshgum/typedi": "^0.7.2",
        "@tsconfig/node26": "^26.0.1",
        "@tsconfig/strictest": "^2.0.8",
        "chalk": "^6.0.1",
        "chokidar": "^5.0.0",
        "class-transformer": "^0.5.1",
        "cli-progress": "^3.12.0",
        "commander": "^15.0.0",
        "es-toolkit": "^1.52.0",
        "fastify": "^5.12.7",
        "hash-wasm": "^4.12.0",
        "hjson": "^3.2.2",
        "semver": "^7.8.5",
        "source-map-support": "^0.5.21",
        "strip-ansi": "^7.2.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@types/cli-progress": "^3.11.6",
        "@types/hjson": "^2.4.6",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.8.0",
        "@types/ws": "^8.18.2",
        "@yao-pkg/pkg": "^6.23.0",
        "concurrently": "^10.0.6",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "rimraf": "^6.1.3",
        "tsup": "^9.0.0",
        "typescript": "^6.0.3"
    }
}
