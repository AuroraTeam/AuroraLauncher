{
    "extends": ["@tsconfig/strictest/tsconfig", "@tsconfig/node26/tsconfig"],
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "paths": {
            "@root/*": ["./src/*"]
        },
        "exactOptionalPropertyTypes": false
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "test"]
}
