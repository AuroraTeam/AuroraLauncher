    "dependencies": {
        "@aurora-launcher/core": "workspace:^"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tsconfig/node26": "^26.0.1",
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "^26.6.5",
        "globals": "^17.13.0",
        "tsdown": "0.23.1",
        "typescript": "^7.0.2",
